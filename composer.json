{
    "name": "smart-cms/panel-translate",
    "description": "This is my package panel-translate",
    "keywords": [
        "SmartCms",
        "laravel",
        "panel-translate"
    ],
    "homepage": "https://github.com/smartcms/panel-translate",
    "support": {
        "issues": "https://github.com/smartcms/panel-translate/issues",
        "source": "https://github.com/smartcms/panel-translate"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "maxboyko",
            "email": "maxboiko@divotek.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^2.1",
        "pestphp/pest-plugin-arch": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SmartCms\\PanelTranslate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SmartCms\\PanelTranslate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SmartCms\\PanelTranslate\\PanelTranslateServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
